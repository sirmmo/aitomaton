# ---- aitomaton
AITOMATON_PUBLIC_URL=http://localhost:8790
# AITOMATON_STATUS_TOKEN=            # set it to protect / and /status.json (?token=... or Bearer)
AITOMATON_DEFAULT_POLICY=report     # for services without aitomaton.policy: observe | report | pr | push
AITOMATON_DISPATCH=0                # 0 = dry run: decide and prepare briefs, send nothing. 1 = act.
AITOMATON_DECIDER=chain             # rules | laya | jev | llm | chain
AITOMATON_CHAIN=laya,jev,llm        # chain order after the rules; the next tier is asked only while unsure
ESCALATE_BELOW=0.6                  # confidence under which the next tier is asked

# ---- input: Sentry or urgentry (same /api/0/ API). Webhooks go to POST /hooks/sentry.
SENTRY_URL=                         # https://sentry.io or http://urgentry:8000
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECTS=                    # comma separated; empty = every project of the org
SENTRY_HOOK_SECRET=                 # integration client secret, verifies Sentry-Hook-Signature

# ---- input: Prometheus (context queries) and Alertmanager (POST /hooks/alertmanager?token=...)
PROMETHEUS_URL=
ALERTMANAGER_HOOK_SECRET=

# ---- infrastructure: the swarm itself (nodes, quorum, replicas, OOM kills, image pulls). Its issues go to
# an outlet repo holding the stack files; a service can name its own with the aitomaton.infra.repo label.
# AITOMATON_INFRA=1
# AITOMATON_INFRA_REPO=acme/infra
# AITOMATON_INFRA_PATH=stacks/
# AITOMATON_INFRA_POLICY=report
# AITOMATON_INFRA_CREDENTIAL=infra
# AITOMATON_INFRA_TEST=docker stack config -c stacks/edge.yml

# ---- decision: laya (set by the stack), JEV on OpenRouter, any OpenAI-compatible LLM
JEV_MODEL=typesafe/jev-router       # TypeSafe's System One router; empty = tier off
JEV_BASE_URL=                       # default: LLM_BASE_URL
JEV_API_KEY=                        # default: LLM_API_KEY
LLM_BASE_URL=https://openrouter.ai/api/v1   # or http://ollama:11434/v1 for a local model
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# ---- execution: stairway spaces where a coding agent fixes the issue
STAIRWAY_URL=http://172.18.0.1:8765
STAIRWAY_TOKEN=
STAIRWAY_AGENT=claude               # claude | opencode | crush | openclaude
STAIRWAY_MODEL=                     # for non-claude agents, an OpenRouter model id (typesafe/jev-router works too)
STAIRWAY_PERMISSION_MODE=acceptEdits
AITOMATON_CALLBACK_URL=http://localhost:8790/hooks/stairway
AITOMATON_CALLBACK_SECRET=          # 16+ chars; enables stairway callbacks (otherwise it polls)
MAX_RUNNING_WORKS=2
MAX_WORKS_PER_DAY=5

# ---- git credentials (PRs, pushes, issues), resolved per service, most specific first:
#   label aitomaton.git.credential=<name>  -> Docker secret aitomaton_git_<name>, or AITOMATON_GIT_TOKEN_<NAME>
#   the repo owner                          -> AITOMATON_GIT_TOKEN_<OWNER>  (Acme-Corp -> ..._ACME_CORP)
#   everything else                         -> AITOMATON_GIT_TOKEN (or GITHUB_TOKEN)
# Use fine-grained tokens: Contents + Pull requests (+ Issues for reports) read/write, on the repos concerned.
AITOMATON_GIT_TOKEN=
# AITOMATON_GIT_TOKEN_ACME_CORP=
AITOMATON_GIT_AUTHOR=aitomaton <aitomaton@localhost>
